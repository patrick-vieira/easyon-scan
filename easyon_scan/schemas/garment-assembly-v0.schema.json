{
  "type": "object",
  "required": [
    "schema",
    "source",
    "panels",
    "seams",
    "openings",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "garment-assembly/v0"
    },
    "source": {
      "type": "object",
      "required": [
        "file_sha256",
        "units",
        "insunits_code",
        "size"
      ],
      "properties": {
        "file_sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "units": {
          "type": "string"
        },
        "insunits_code": {
          "type": "integer"
        },
        "size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumed_units": {
          "enum": [
            "mm",
            "cm",
            "in",
            "ft",
            "m"
          ]
        }
      },
      "additionalProperties": false
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/panel"
      }
    },
    "seams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seam"
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "edges",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "human_approved",
            "rejected"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyon-scan.org/schemas/garment-assembly-v0.schema.json",
  "$defs": {
    "ring": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 4
    },
    "provenance": {
      "type": "object",
      "required": [
        "handle",
        "layer",
        "dxftype"
      ],
      "properties": {
        "handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "layer": {
          "type": "string"
        },
        "dxftype": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from_mm",
        "to_mm",
        "length_mm",
        "start_vertex",
        "end_vertex",
        "notches",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from_mm": {
          "type": "number",
          "minimum": 0
        },
        "to_mm": {
          "type": "number",
          "minimum": 0
        },
        "length_mm": {
          "type": "number",
          "minimum": 0
        },
        "start_vertex": {
          "type": "integer",
          "minimum": 0
        },
        "end_vertex": {
          "type": "integer",
          "minimum": 0
        },
        "notches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_mm",
              "kind"
            ],
            "properties": {
              "at_mm": {
                "type": "number",
                "minimum": 0
              },
              "kind": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cutline",
        "sewline",
        "sewline_status",
        "grain",
        "on_fold",
        "holes",
        "edges",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cutline": {
          "$ref": "#/$defs/ring"
        },
        "sewline": {
          "anyOf": [
            {
              "$ref": "#/$defs/ring"
            },
            {
              "type": "null"
            }
          ]
        },
        "sewline_status": {
          "enum": [
            "from_dxf",
            "hypothesis_offset",
            "missing"
          ]
        },
        "grain": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "on_fold": {
          "type": "boolean"
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ring"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "seam": {
      "type": "object",
      "required": [
        "id",
        "a",
        "b",
        "orientation",
        "matches",
        "construction",
        "allowance_mm",
        "ease_mm",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "orientation": {
          "enum": [
            "same",
            "reversed",
            "unknown"
          ]
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a_mm",
              "b_mm"
            ],
            "properties": {
              "a_mm": {
                "type": "number",
                "minimum": 0
              },
              "b_mm": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "construction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowance_mm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ease_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
